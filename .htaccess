# Hostinger Apache / LiteSpeed Configuration for Vidhyasthali Library
<IfModule mod_mime.c>
    AddType application/pdf .pdf
    AddType application/json .json
    AddType text/javascript .js
    AddType text/css .css
</IfModule>

<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/pdf
</IfModule>

# Enable Options for Clean Directory Serving
Options -Indexes +FollowSymLinks
